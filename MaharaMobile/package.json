{
    "name": "maharamobile",
    "version": "25.1.5",
    "private": true,
    "scripts": {
        "android": "react-native run-android",
        "ios": "react-native run-ios",
        "start": "react-native start",
        "test": "jest --config .test/jest.config.js",
        "lint": "eslint src/**/*.{ts,tsx}",
        "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
        "prettier": "prettier --check .",
        "prettier:fix": "prettier  --write .",
        "tsc": "tsc",
        "add-locale": "lingui add-locale",
        "extract": "lingui extract",
        "compile": "lingui compile",
        "release": "cd android && ./gradlew assembleRelease",
        "bundlerelease": "cd android && ./gradlew bundleRelease",
        "postversion": "react-native-version",
        "devices": "adb devices",
        "check-deps": "rnx-dep-check",
        "fix-deps": "rnx-dep-check --write",
        "clean": "npx react-native-clean-project",
        "postinstall": "patch-package"
    },
    "codegenConfig": {
        "name": "MaharaMobile",
        "type": "components",
        "jsSrcsDir": "./src",
        "android": {
            "javaPackageName": "org.mahara.mobile.app"
        }
    },
    "dependencies": {
        "@babel/preset-typescript": "7.29.7",
        "@fortawesome/fontawesome-svg-core": "^6.5.2",
        "@fortawesome/free-regular-svg-icons": "^6.5.2",
        "@fortawesome/free-solid-svg-icons": "^6.5.2",
        "@gluestack-style/react": "^1.0.56",
        "@gluestack-ui/config": "^1.1.19",
        "@lingui/core": "^5.9.5",
        "@lingui/react": "^5.9.5",
        "@react-native-aria/focus": "^0.2.9",
        "@react-native-aria/interactions": "^0.2.16",
        "@react-native-aria/overlays": "^0.3.15",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-native-documents/picker": "^12.0.2",
        "@react-native-masked-view/masked-view": "^0.3.2",
        "@react-navigation/bottom-tabs": "^7.7.1",
        "@react-navigation/native": "^7.1.14",
        "@react-navigation/stack": "^7.4.2",
        "@reduxjs/toolkit": "^2.2.5",
        "make-plural": "^7.4.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.2",
        "react-native-device-info": "^11.1.0",
        "react-native-gesture-handler": "^3.0.1",
        "react-native-localize": "^3.2.0",
        "react-native-permissions": "^4.1.5",
        "react-native-safe-area-context": "^5.8.0",
        "react-native-screens": "^4.26.2",
        "react-native-svg": "^15.15.3",
        "react-native-uuid": "^2.0.2",
        "react-native-version": "^4.0.0",
        "react-native-webview": "^13.14.1",
        "react-redux": "^9.1.2",
        "redux-logger": "^3.0.6"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/plugin-transform-class-static-block": "7.29.7",
        "@babel/preset-env": "7.29.7",
        "@babel/runtime": "7.29.7",
        "@fortawesome/react-native-fontawesome": "^0.3.2",
        "@gluestack-ui/themed-native-base": "^0.1.108",
        "@lingui/cli": "^5.9.5",
        "@lingui/macro": "^5.9.5",
        "@react-native-community/cli": "20.1.0",
        "@react-native-community/cli-platform-android": "20.1.0",
        "@react-native-community/cli-platform-ios": "20.1.0",
        "@react-native/babel-preset": "0.86.2",
        "@react-native/eslint-config": "0.86.2",
        "@react-native/jest-preset": "0.86.2",
        "@react-native/metro-config": "0.86.2",
        "@react-native/typescript-config": "0.86.2",
        "@testing-library/react-native": "^13.0.0",
        "@trivago/prettier-plugin-sort-imports": "^4.3.0",
        "@tsconfig/react-native": "^3.0.5",
        "@types/jest": "^29.5.13",
        "@types/react": "19.2.0",
        "@types/react-test-renderer": "^19.1.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.0.0",
        "babel-plugin-macros": "^3.1.0",
        "babel-plugin-module-resolver": "^5.0.2",
        "check-peer-dependencies": "^4.3.0",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^8.19.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-airbnb-typescript": "^18.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jsx-a11y": "^6.9.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-native": "^4.1.0",
        "jest": "^29.2.1",
        "patch-package": "^8.0.1",
        "prettier": "2.8.8",
        "react-native-aria": "^0.2.3",
        "react-native-blob-util": "^0.24.10",
        "react-native-image-picker": "^8.2.1",
        "react-test-renderer": "19.2.3",
        "redux-mock-store": "^1.5.4",
        "ts-jest": "^29.1.4",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=22"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "overrides": {
        "react": "$react",
        "react-dom": "$react"
    }
}
